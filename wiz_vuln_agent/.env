# Copy to `.env` at repo root (and/or `wiz_vuln_agent/.env`). ADK loads both.

# -----------------------------------------------------------------------------
# Google AI (Gemini) via ADK — same pattern as `main` branch `devops_builder`
# -----------------------------------------------------------------------------
# Create a key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyCHRk-bUPryg9ACddi0g8It0hxJ5J6UcXE
# Optional: Set to TRUE if using Vertex AI instead of AI Studio
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Gemini model (Pro default). Examples: gemini-2.5-pro, gemini-2.5-flash, gemini-3-pro-preview
ADK_MODEL=gemini-3.1-pro-preview
# Force native Gemini when both GOOGLE_API_KEY and OPENAI_* appear in your file:
# LLM_PROVIDER=gemini

# -----------------------------------------------------------------------------
# Optional: enterprise OpenAI-compatible gateway (LiteLLM) instead of Gemini
# -----------------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openai.prod.ai-gateway.quantumblack.com/.../v1
# OPENAI_MODEL=gpt-5-nano-2025-08-07
# OPENAI_API_KEY=
# If gateway returns 403 "The token is expired", refresh OPENAI_API_KEY (MID JWT).

# --- Wiz MCP (browser OAuth via mcp-remote; tokens under ~/.mcp-auth) ---
# https://docs.wiz.io/docs/set-up-wiz-mcp-server
WIZ_MCP_REMOTE_URL=https://mcp.app.wiz.io/

PATCAT_MCP_REMOTE_URL=https://patcat.avm.mckinsey.com/mcp

# WIZ_MCP_REMOTE_OAUTH_PORT=3334
WIZ_MCP_REMOTE_EXTRA_ARGS=--debug
WIZ_MCP_NPX=npx

# WIZ_MCP_URL= + WIZ_MCP_HEADERS_JSON= for direct HTTP MCP (bearer already in hand)

# Optional MCP tool caps (OpenAI path)
# OPENAI_MAX_MCP_TOOLS=
# OPENAI_MAX_WIZ_MCP_TOOLS=
# OPENAI_MAX_PATCAT_MCP_TOOLS=
LLM_PROVIDER=gemini
