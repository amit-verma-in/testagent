# Copy to .env in this directory (or export in your shell). ADK also loads .env from the app parent folder.

# Gemini / Google AI (required for LlmAgent)
GOOGLE_API_KEY=

# --- Recommended: browser OAuth (no WIZ_CLIENT_ID / WIZ_CLIENT_SECRET in this file) ---
# Paste the remote MCP URL from Wiz (integration portal / docs). ADK talks to stdio; npx runs
# mcp-remote, which performs MCP OAuth and opens your browser. Tokens are cached under ~/.mcp-auth
# https://docs.wiz.io/docs/set-up-wiz-mcp-server
#
# WIZ_MCP_REMOTE_URL=https://...your-tenant.../...mcp...
#
# Optional: OAuth redirect listener port (default 3334 if unset)
# WIZ_MCP_REMOTE_OAUTH_PORT=3334
#
# Optional: isolate sessions per tenant / resource (mcp-remote --resource)
# WIZ_MCP_REMOTE_RESOURCE=https://your-tenant.app.wiz.io/
#
# Optional: extra mcp-remote flags, e.g. --debug or --host 127.0.0.1
# WIZ_MCP_REMOTE_EXTRA_ARGS=--debug
#
# WIZ_MCP_NPX=npx

# --- Alternative: machine credentials (if Wiz gives you a local MCP that reads these) ---
# WIZ_CLIENT_ID=
# WIZ_CLIENT_SECRET=

# --- Alternative: manual stdio (exact command from Wiz portal / Cursor MCP config) ---
# WIZ_MCP_COMMAND=npx
# WIZ_MCP_ARGS=-y PLACEHOLDER_PACKAGE_FROM_WIZ_PORTAL

# --- Alternative: direct HTTP from ADK (needs a bearer token already; no browser OAuth) ---
# WIZ_MCP_URL=https://your-mcp-endpoint.example/mcp
# WIZ_MCP_HEADERS_JSON={"Authorization":"Bearer ..."}

# Optional model override
# ADK_MODEL=gemini-2.5-flash
