# Copy to `.env` at repo root. See `wiz_vuln_agent/agent.py` for LLM routing.

GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
ADK_MODEL=gemini-2.5-pro

# Local file tools (`write_local_workspace_file`, etc.): default `<repo>/agent_output/`
# AGENT_LOCAL_OUTPUT_DIR=/absolute/path/to/output
# AGENT_LOCAL_FILE_MAX_BYTES=2097152
